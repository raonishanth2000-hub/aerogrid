# Backend settings. Copy to .env and fill in; never commit .env.

# Only needed to download sensor data with `python -m aerogrid.fetch_data`.
OPENAQ_API_KEY=

# Study area (defaults: Delhi). Bengaluru: 12.9716 / 77.5946.
CENTER_LAT=28.6139
CENTER_LON=77.2090
SEARCH_RADIUS_M=25000
LOCAL_TIMEZONE=Asia/Kolkata

# What data/training_dataset.csv contains: "modelled" (e.g. CAMS) or "measured" (sensor readings).
STATION_DATA_KIND=modelled
STATION_DATA_SOURCE=CAMS model (Copernicus) via Open-Meteo

# Set to 1 to skip OpenStreetMap road lookups and use only the cache in data/geo_cache.json.
GEO_OFFLINE=

# Optional AWS (S3 sync, SageMaker training)
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET_NAME=
S3_PREFIX=aerogrid
SAGEMAKER_ROLE_ARN=
