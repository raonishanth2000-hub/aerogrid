# AeroGrid frontend configuration — copy to .env.local and edit.
# Every VITE_ variable is bundled into the browser JavaScript. Never put API keys,
# AWS credentials or any other secret here.

# "mock" = clearly labelled synthetic DEMO data from src/data/ (no backend needed).
# "api"  = call the backend at VITE_API_BASE_URL. Failed requests show errors; they never fall back to demo data.
# If unset: mock during `npm run dev`, api in production builds.
VITE_DATA_MODE=mock

# Backend base URL, no trailing slash. Required in api mode.
VITE_API_BASE_URL=http://localhost:8000

# Optional: initial city id (must exist in CITIES in src/config/index.ts). Defaults to delhi,
# the study area the current model is trained and validated on.
# VITE_DEFAULT_CITY=delhi

# Optional (api mode): comma-separated city ids the backend actually serves. Defaults to the
# default city only. Only list cities the model has been trained on.
# In mock mode every configured city is offered with synthetic demo data.
# VITE_API_CITIES=delhi

# Optional: observations older than this many minutes are flagged as stale (default 180).
# VITE_STALE_AFTER_MINUTES=180

# Optional: XYZ basemap override. The default Esri canvas is keyless; check the provider's
# terms before serving production traffic.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
